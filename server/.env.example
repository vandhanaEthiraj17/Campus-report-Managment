# ==============================================================================
# SMARTCAMPUS BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated in production)
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection
# In production, use a secure connection string with authentication:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smart_campus_db

# Authentication Security
# CRITICAL: In production (NODE_ENV=production), JWT_SECRET MUST be set to a cryptographically
# secure string of at least 32 characters. Do not use default or placeholder values!
JWT_SECRET=replace_with_a_secure_random_32_character_secret_key_in_production

# Campus Domain Configuration
COLLEGE_EMAIL_DOMAIN=@campus.edu

# Emergency Dispatch Configuration
# Comma-separated designated mobile numbers for urgent/high-risk/women-safety notifications
EMERGENCY_SMS_RECIPIENTS=+919952912177,+916382373918
EMERGENCY_ALERT_NUMBERS=+919952912177,+916382373918

# Production Twilio SMS Telecom Gateway Configuration
# Required only if real cellular SMS dispatch is enabled.
# When omitted, the system defaults to safe local simulation without failing requests.
TWILIO_ACCOUNT_SID=AC_YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+12345678901
# Alternatively, specify a Twilio Messaging Service SID:
TWILIO_MESSAGING_SERVICE_SID=MG_YOUR_MESSAGING_SERVICE_SID_HERE

# Twilio Public Status Callback Base URL (Required for delivery status webhooks)
# In production, this must be an accessible HTTPS URL: https://yourcampusdomain.edu
TWILIO_STATUS_CALLBACK_URL=http://localhost:5000/api/emergency/twilio/status-callback
