# ==============================================================================
# SMARTCAMPUS FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local to customize local development variables.
# ==============================================================================

# Backend API Base URL
# In development, Vite automatically proxies /api to http://localhost:5000.
# In production, set this to your hosted backend API URL if not served behind a reverse proxy.
# VITE_API_BASE_URL=https://api.yourdomain.edu/api/v1
VITE_API_BASE_URL=/api/v1
